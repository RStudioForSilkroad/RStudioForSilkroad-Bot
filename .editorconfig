root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Windows PowerShell 5.1 and the C# compiler need a BOM to read non-ASCII text correctly.
[*.{cs,ps1}]
charset = utf-8-bom

[*.md]
trim_trailing_whitespace = false

[*.{json,xml,yml,yaml}]
indent_size = 2
